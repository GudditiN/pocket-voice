Oka# In Codespaces, set GROQ_API_KEY (and optionally APP_PASSWORD) as Codespaces secrets instead of using this file.
GROQ_API_KEY=
GROQ_ASR_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=llama-3.3-70b-versatile
# groq | local  (local needs: uv sync --extra local-asr)
ASR_BACKEND=groq
SYSTEM_PROMPT=You are a friendly voice assistant. Answer in one to three short spoken sentences. Plain text only: no markdown, lists, or emojis.
DATA_DIR=./data
RETENTION_DAYS=14
REQUEST_TIMEOUT_S=30
HISTORY_TURNS=6
SAMPLE_INTERVAL_S=5
# Optional: require a password to open the app
APP_PASSWORD=
