Oka# In Codespaces, set GROQ_API_KEY (and optionally APP_PASSWORD) as Codespaces secrets instead of using this file.
GROQ_API_KEY=
# Hugging Face read token. Required for voice cloning: accept the terms at https://huggingface.co/kyutai/pocket-tts first.
HF_TOKEN=
GROQ_ASR_MODEL=whisper-large-v3-turbo
# Self-serve chat models per console.groq.com/docs/models: openai/gpt-oss-20b (fastest), openai/gpt-oss-120b.
# The older Llama models were retired for free and developer plans on 16 August 2026 and return 404.
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Live answers: let the assistant search the web and read pages, news, markets and weather (1 = on by default)
LIVE_DATA=1
# Optional but recommended: free key (1,000 searches/month) from https://tavily.com for dependable web search
TAVILY_API_KEY=
# Country for news and search, and the time zone for "today"
LIVE_REGION=IN
APP_TIMEZONE=Asia/Kolkata
# Answer SniffyNose and pet-shopping questions from sniffynose.com (needs web search on)
SNIFFYNOSE=1
# Product searches: show cards and say one short prepared phrase (much faster than reading details)
PRODUCT_QUICK_REPLY=1
# Only if you own SniffyNest and want it read, despite its robots.txt asking otherwise
SNIFFYNEST_ALLOWED=0
# groq | local  (local needs: uv sync --extra local-asr)
ASR_BACKEND=groq
# How the assistant talks. Leave blank for the built-in natural, phone-call style.
SYSTEM_PROMPT=
# Fast reply: speak while the answer is still being written
FAST_REPLY=1
# Short "let me check" phrases in your voice while waiting
FILLERS=1
# Load the voice model when the app starts, so the first question is quicker
POCKET_WARMUP=1
# Voice tuning (optional; restart after changing). Blank = saved setting or default.
# How expressive: default 0.3, range 0.05-1.5
POCKET_TEMP=
# Quality steps: default 1, range 1-8 (higher is slower)
POCKET_STEPS=
# End of speech: default -4, range -10 to 5 (raise if endings are cut off)
POCKET_EOS_THRESHOLD=
# 1 = smaller, faster int8 model
POCKET_QUANTIZE=0
# Default background-noise reduction for NEW voice samples: off | light | medium | strong
POCKET_DENOISE=off
DATA_DIR=./data
RETENTION_DAYS=14
REQUEST_TIMEOUT_S=30
HISTORY_TURNS=6
SAMPLE_INTERVAL_S=5
# Optional: require a password to open the app. Generated for you by ./run.sh --expose if empty.
APP_PASSWORD=
# On a public link, needed to create or delete voices. Must differ from APP_PASSWORD. Use 12+ characters.
ADMIN_PASSWORD=
